<%- include("../partials/header", { title, mapAssets: mission.latitude !== null && mission.longitude !== null }) %>
<section class="page-heading">
  <div>
    <p class="eyebrow"><%= t("missions.show.eyebrow", { id: mission.id }) %></p>
    <h1><%= mission.name %></h1>
    <span class="status status-<%= mission.status %>"><%= t(`status.${mission.status}`) %></span>
  </div>
  <a class="button" href="/missions"><%= t("missions.show.back") %></a>
</section>

<section class="detail-grid">
  <article class="panel details">
    <h2><%= t("common.information") %></h2>
    <dl>
      <dt><%= t("common.region") %></dt><dd><%= mission.region %></dd>
      <dt><%= t("common.period") %></dt><dd><%= t("missions.show.periodValue", { start: mission.start_date || "-", end: mission.end_date || "-" }) %></dd>
      <dt><%= t("nav.agents") %></dt><dd><%= mission.collectors %></dd>
      <dt><%= t("missions.show.koboForm") %></dt><dd><%= mission.kobo_asset_uid || t("missions.show.notConfigured") %></dd>
    </dl>
  </article>
  <% if (mission.latitude !== null && mission.longitude !== null) { %>
    <article class="panel">
      <h2><%= t("common.location") %></h2>
      <div id="detail-map" class="detail-map"></div>
    </article>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
      const map = L.map("detail-map").setView([<%= mission.latitude %>, <%= mission.longitude %>], 10);
      L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
        attribution: "&copy; OpenStreetMap contributors"
      }).addTo(map);
      L.marker([<%= mission.latitude %>, <%= mission.longitude %>]).addTo(map);
    </script>
  <% } %>
</section>
<%- include("../partials/footer") %>
