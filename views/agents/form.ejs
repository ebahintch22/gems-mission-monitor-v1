<%- include("../partials/header", { title }) %>
<section class="page-heading">
  <div>
    <p class="eyebrow"><%= t("agents.eyebrow") %></p>
    <h1><%= formHeading %></h1>
    <p class="muted"><%= t("agents.form.description") %></p>
  </div>
</section>

<section class="panel form-panel">
  <% if (error) { %><p class="alert" role="alert"><%= error %></p><% } %>
  <form action="<%= formAction %>" method="post" class="agent-form">
    <label><%= t("agents.fields.lastName") %>
      <input name="nom" required value="<%= values.nom || "" %>">
    </label>
    <label><%= t("agents.fields.firstNames") %>
      <input name="prenoms" required value="<%= values.prenoms || "" %>">
    </label>
    <label><%= t("agents.fields.code") %>
      <input name="code_agent" required value="<%= values.code_agent || "" %>" placeholder="<%= t("common.placeholderExample", { example: "AG-001" }) %>">
    </label>
    <label><%= t("agents.fields.status") %>
      <select name="statut" required>
        <% statuses.forEach((statut) => { %>
          <option value="<%= statut %>" <%= (values.statut || "actif") === statut ? "selected" : "" %>><%= t(`status.${statut}`) %></option>
        <% }) %>
      </select>
    </label>
    <label><%= t("agents.fields.phone") %>
      <input type="tel" name="telephone" value="<%= values.telephone || "" %>">
    </label>
    <label><%= t("agents.fields.equipment") %>
      <input name="equipement" value="<%= values.equipement || "" %>" placeholder="<%= t("common.placeholderExample", { example: t("agents.placeholders.equipment") }) %>">
    </label>
    <label><%= t("agents.fields.userAccount") %>
      <select name="user_id">
        <option value=""><%= t("common.noAppAccount") %></option>
        <% agentUsers.forEach((user) => { %>
          <option value="<%= user.id %>" <%= Number(values.user_id) === user.id ? "selected" : "" %>><%= user.prenoms %> <%= user.nom %></option>
        <% }) %>
      </select>
      <% if (!agentUsers.length) { %><small class="muted"><%= t("agents.fields.noAgentUser") %></small><% } %>
    </label>
    <label><%= t("common.team") %>
      <select name="equipe_id">
        <option value=""><%= t("agents.fields.assignLater") %></option>
        <% equipes.forEach((equipe) => { %>
          <option value="<%= equipe.id %>" <%= Number(values.equipe_id) === equipe.id ? "selected" : "" %>><%= equipe.nom_equipe %> (<%= t(`status.${equipe.statut}`) %>)</option>
        <% }) %>
      </select>
      <% if (!equipes.length) { %><small class="muted"><%= t("agents.fields.noTeam") %></small><% } %>
    </label>
    <div class="form-actions">
      <a class="button" href="<%= cancelHref %>"><%= t("common.cancel") %></a>
      <button class="button button-primary" type="submit"><%= submitLabel %></button>
    </div>
  </form>
</section>
<%- include("../partials/footer") %>
