<%- include("../partials/header", { title }) %>
<section class="page-heading">
  <div>
    <p class="eyebrow"><%= t("admin.eyebrow") %></p>
    <h1><%= t("admin.systemStatus.title") %></h1>
    <p class="muted"><%= t("admin.systemStatus.description") %></p>
  </div>
  <div class="heading-actions">
    <%- include("../partials/admin-close-button") %>
    <a class="button secondary" href="/admin"><%= t("admin.actions.back") %></a>
  </div>
</section>

<section class="panel">
  <div class="panel-header">
    <h2><%= t("admin.systemStatus.metadataTitle") %></h2>
  </div>

  <% if (!metadata) { %>
    <p class="empty"><%= t("admin.systemStatus.empty") %></p>
  <% } else { %>
    <table class="simple-table">
      <tbody>
        <tr>
          <th><%= t("admin.systemStatus.fields.appName") %></th>
          <td><%= metadata.app_name %></td>
        </tr>
        <tr>
          <th><%= t("admin.systemStatus.fields.releaseVersion") %></th>
          <td><%= metadata.release_version %></td>
        </tr>
        <tr>
          <th><%= t("admin.systemStatus.fields.releaseLabel") %></th>
          <td><%= metadata.release_label %></td>
        </tr>
        <tr>
          <th><%= t("admin.systemStatus.fields.releaseDate") %></th>
          <td><%= metadata.release_date %></td>
        </tr>
        <tr>
          <th><%= t("admin.systemStatus.fields.environment") %></th>
          <td><%= metadata.environment %></td>
        </tr>
        <tr>
          <th><%= t("admin.systemStatus.fields.updatedAt") %></th>
          <td><%= metadata.updated_at %></td>
        </tr>
        <tr>
          <th><%= t("admin.systemStatus.fields.notes") %></th>
          <td><%= metadata.notes || t("common.notProvided") %></td>
        </tr>
      </tbody>
    </table>
  <% } %>
</section>
<%- include("../partials/footer") %>
