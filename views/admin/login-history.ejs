<%- include("../partials/header", { title }) %>
<section class="page-heading">
  <div>
    <p class="eyebrow"><%= t("admin.eyebrow") %></p>
    <h1><%= t("admin.loginHistory.title") %></h1>
    <p class="muted"><%= t("admin.loginHistory.description") %></p>
  </div>
  <div class="heading-actions">
    <%- include("../partials/admin-close-button") %>
    <a class="button" href="/admin"><%= t("common.back") %></a>
  </div>
</section>

<section class="panel">
  <% if (!loginAttempts.length) { %>
    <p class="empty"><%= t("admin.loginHistory.empty") %></p>
  <% } else { %>
    <table class="simple-table">
      <thead>
        <tr>
          <th><%= t("admin.loginHistory.date") %></th>
          <th><%= t("common.email") %></th>
          <th><%= t("common.user") %></th>
          <th><%= t("common.status") %></th>
          <th><%= t("admin.loginHistory.reason") %></th>
          <th><%= t("admin.loginHistory.ip") %></th>
          <th><%= t("admin.loginHistory.userAgent") %></th>
        </tr>
      </thead>
      <tbody>
        <% loginAttempts.forEach((attempt) => { %>
          <tr>
            <td><%= attempt.created_at %></td>
            <td><%= attempt.email || "-" %></td>
            <td><%= attempt.user_name || "-" %></td>
            <td>
              <span class="status status-<%= attempt.success ? "validee" : "rejetee" %>">
                <%= attempt.success ? t("admin.loginHistory.success") : t("admin.loginHistory.failure") %>
              </span>
            </td>
            <td><%= attempt.failure_reason || "-" %></td>
            <td><%= attempt.ip_address || "-" %></td>
            <td><code><%= attempt.user_agent || "-" %></code></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</section>
<%- include("../partials/footer") %>
