<%- include("../partials/header", { title }) %>
<section class="page-heading">
  <div>
    <p class="eyebrow"><%= t("admin.eyebrow") %></p>
    <h1><%= t("admin.settings.title") %></h1>
    <p class="muted"><%= t("admin.settings.description") %></p>
  </div>
  <div class="heading-actions">
    <%- include("../partials/admin-close-button") %>
    <a class="button" href="/admin"><%= t("admin.actions.back") %></a>
  </div>
</section>

<% if (notice) { %><p class="alert alert-success" role="status"><%= notice %></p><% } %>
<% if (error) { %><p class="alert" role="alert"><%= error %></p><% } %>

<form action="/admin/settings" method="post" class="admin-settings-form">
  <% Object.entries(groupedSettings).forEach(([groupName, settings]) => { %>
    <section class="panel">
      <div class="panel-header">
        <h2><%= groupLabels[groupName] || groupName %></h2>
      </div>
      <div class="admin-settings-grid">
        <% settings.forEach((setting) => { %>
          <label>
            <span><%= setting.label %></span>
            <% if (setting.type === "boolean") { %>
              <span class="checkbox-label">
                <input type="checkbox" name="settings[<%= setting.key %>]" <%= setting.value === "true" ? "checked" : "" %>>
                <%= t("admin.settings.booleanEnabled") %>
              </span>
            <% } else if (setting.key === "app.default_mission_id") { %>
              <select name="settings[<%= setting.key %>]">
                <option value=""><%= t("admin.settings.defaultMission.none") %></option>
                <% missions.forEach((mission) => { %>
                  <option value="<%= mission.id %>" <%= String(setting.value || "") === String(mission.id) ? "selected" : "" %>>
                    <%= mission.name %> (<%= t(`status.${mission.status}`) %>)
                  </option>
                <% }) %>
              </select>
            <% } else if (setting.key === "map.geometry_import_results_target") { %>
              <select name="settings[<%= setting.key %>]">
                <option value="floating" <%= setting.value === "floating" ? "selected" : "" %>>Fenetre flottante</option>
                <option value="layerbox" <%= setting.value === "layerbox" ? "selected" : "" %>>LayerBox - Resultat de l'importation</option>
              </select>
            <% } else if (setting.key.endsWith("_stroke_color")) { %>
              <input
                type="color"
                name="settings[<%= setting.key %>]"
                value="<%= setting.value || "#000000" %>"
              >
            <% } else if (setting.key.endsWith("_dash_style")) { %>
              <select name="settings[<%= setting.key %>]">
                <option value="solid" <%= setting.value === "solid" ? "selected" : "" %>>Continu</option>
                <option value="dashed" <%= setting.value === "dashed" ? "selected" : "" %>>Pointille</option>
                <option value="dotted" <%= setting.value === "dotted" ? "selected" : "" %>>Points</option>
                <option value="dashdot" <%= setting.value === "dashdot" ? "selected" : "" %>>Mixte</option>
              </select>
            <% } else if (setting.key.endsWith("_fill_opacity")) { %>
              <input
                type="number"
                min="0"
                max="1"
                step="0.05"
                name="settings[<%= setting.key %>]"
                value="<%= setting.value || "0" %>"
              >
            <% } else if (setting.key.endsWith("_stroke_weight")) { %>
              <input
                type="number"
                min="1"
                max="12"
                step="1"
                name="settings[<%= setting.key %>]"
                value="<%= setting.value || "1" %>"
              >
            <% } else if (setting.key === "search.site_fields") { %>
              <div class="checkbox-grid">
                <%
                  let selectedSearchFields = [];
                  try {
                    selectedSearchFields = JSON.parse(setting.value || "[]");
                  } catch (error) {
                    selectedSearchFields = [];
                  }
                  const searchFieldOptions = [
                    ["nom_officiel", "Nom officiel"],
                    ["sous_prefecture", "Sous-préfecture"],
                    ["ville", "Ville / commune"],
                    ["region", "Région"],
                    ["type_infrastructure", "Type d'infrastructure"]
                  ];
                %>
                <% searchFieldOptions.forEach(([value, label]) => { %>
                  <span class="checkbox-label">
                    <input
                      type="checkbox"
                      name="settings[<%= setting.key %>][]"
                      value="<%= value %>"
                      <%= selectedSearchFields.includes(value) ? "checked" : "" %>
                    >
                    <%= label %>
                  </span>
                <% }) %>
              </div>
            <% } else if (setting.type === "secret") { %>
              <input
                type="password"
                name="settings[<%= setting.key %>]"
                placeholder="<%= setting.configured ? t("admin.settings.secretConfigured") : t("admin.settings.secretEmpty") %>"
                autocomplete="off"
              >
            <% } else { %>
              <input
                type="<%= setting.type === "number" ? "number" : "text" %>"
                name="settings[<%= setting.key %>]"
                value="<%= setting.value || "" %>"
              >
            <% } %>
            <% if (setting.description) { %>
              <span class="form-hint"><%= setting.description %></span>
            <% } %>
          </label>
        <% }) %>
      </div>
    </section>
  <% }) %>
  <div class="form-actions">
    <button class="button button-primary" type="submit">
      <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>
      <%= t("admin.settings.actions.save") %>
    </button>
  </div>
</form>
<%- include("../partials/footer") %>
