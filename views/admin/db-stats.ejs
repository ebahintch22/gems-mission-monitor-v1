<%- include("../partials/header", { title }) %>
<section class="page-heading">
  <div>
    <p class="eyebrow"><%= t("admin.eyebrow") %></p>
    <h1><%= t("admin.dbStats.title") %></h1>
    <p class="muted"><%= t("admin.dbStats.description") %></p>
  </div>
  <div class="heading-actions">
    <a class="button" href="/admin"><%= t("admin.actions.back") %></a>
  </div>
</section>

<section class="stats" aria-label="<%= t("admin.dbStats.indicators") %>">
  <div>
    <span><%= t("admin.dbStats.totalTables") %></span>
    <strong><%= stats.totalTables %></strong>
  </div>
  <div>
    <span><%= t("admin.dbStats.totalSubmissions") %></span>
    <strong><%= stats.metrics ? stats.metrics.submissionCount : 0 %></strong>
  </div>
  <div>
    <span><%= t("admin.dbStats.lastSubmission") %></span>
    <strong><%= stats.metrics && stats.metrics.lastSubmittedAt ? stats.metrics.lastSubmittedAt : "-" %></strong>
  </div>
  <div>
    <span><%= t("admin.dbStats.lastSync") %></span>
    <strong><%= stats.metrics && stats.metrics.lastSyncedAt ? stats.metrics.lastSyncedAt : "-" %></strong>
  </div>
</section>

<% Object.entries(stats.groupedTables).forEach(([category, tables]) => { %>
  <section class="panel admin-db-category">
    <div class="panel-header">
      <h2><%= categoryLabels[category] || category %></h2>
      <span class="muted"><%= tables.length %> table(s)</span>
    </div>
    <% tables.forEach((table) => { %>
      <details class="admin-db-table">
        <summary>
          <strong><%= table.name %></strong>
          <span><%= t("admin.dbStats.records", { count: table.recordCount ?? "-" }) %></span>
          <span><%= t("admin.dbStats.fields", { count: table.columnCount }) %></span>
          <a class="button admin-db-preview-link" href="/admin/db-stats?table=<%= encodeURIComponent(table.name) %>"><%= t("admin.dbStats.actions.preview") %></a>
        </summary>
        <table class="simple-table">
          <thead>
            <tr>
              <th><%= t("admin.dbStats.field.name") %></th>
              <th><%= t("admin.dbStats.field.type") %></th>
              <th><%= t("admin.dbStats.field.required") %></th>
              <th><%= t("admin.dbStats.field.default") %></th>
              <th><%= t("admin.dbStats.field.pk") %></th>
            </tr>
          </thead>
          <tbody>
            <% table.columns.forEach((column) => { %>
              <tr>
                <td><code><%= column.name %></code></td>
                <td><%= column.type || "-" %></td>
                <td><%= column.notnull ? "yes" : "no" %></td>
                <td><%= column.dflt_value || "-" %></td>
                <td><%= column.pk ? "yes" : "no" %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        <% if (table.foreignKeys.length) { %>
          <p class="form-hint"><%= t("admin.dbStats.foreignKeys") %></p>
          <ul class="admin-inline-list">
            <% table.foreignKeys.forEach((foreignKey) => { %>
              <li><code><%= foreignKey.from %></code> -> <code><%= foreignKey.table %>.<%= foreignKey.to %></code></li>
            <% }) %>
          </ul>
        <% } %>
      </details>
    <% }) %>
  </section>
<% }) %>

<section class="panel admin-db-preview" id="table-data">
  <div class="panel-header">
    <div>
      <h2><%= t("admin.dbStats.preview.title") %></h2>
      <p class="muted"><%= t("admin.dbStats.preview.description") %></p>
    </div>
  </div>

  <form class="admin-db-preview-form" method="get" action="/admin/db-stats#table-data">
    <label>
      <%= t("admin.dbStats.preview.table") %>
      <select name="table">
        <option value=""><%= t("admin.dbStats.preview.selectTable") %></option>
        <% stats.tables.forEach((table) => { %>
          <option value="<%= table.name %>" <%= selectedTable === table.name ? "selected" : "" %>><%= table.name %></option>
        <% }) %>
      </select>
    </label>
    <label>
      <%= t("admin.dbStats.preview.limit") %>
      <select name="limit">
        <% [10, 25, 50, 100].forEach((limit) => { %>
          <option value="<%= limit %>" <%= tablePreview && tablePreview.limit === limit ? "selected" : "" %>><%= limit %></option>
        <% }) %>
      </select>
    </label>
    <button class="button button-primary" type="submit"><%= t("admin.dbStats.actions.preview") %></button>
  </form>

  <% if (selectedTable && !tablePreview) { %>
    <p class="alert"><%= t("admin.dbStats.preview.invalidTable") %></p>
  <% } %>

  <% if (tablePreview) { %>
    <div class="panel-header admin-db-preview-header">
      <h3><%= tablePreview.tableName %></h3>
      <span class="muted"><%= t("admin.dbStats.preview.pageInfo", {
        page: tablePreview.page,
        pages: tablePreview.totalPages,
        total: tablePreview.totalRows
      }) %></span>
    </div>
    <div class="admin-db-preview-scroll">
      <table class="simple-table admin-db-preview-table">
        <thead>
          <tr>
            <% tablePreview.columns.forEach((column) => { %>
              <th><code><%= column.name %></code></th>
            <% }) %>
          </tr>
        </thead>
        <tbody>
          <% if (tablePreview.rows.length) { %>
            <% tablePreview.rows.forEach((row) => { %>
              <tr>
                <% tablePreview.columns.forEach((column) => { %>
                  <td><%= row[column.name] %></td>
                <% }) %>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="<%= tablePreview.columns.length || 1 %>"><%= t("admin.dbStats.preview.empty") %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
    <nav class="admin-db-preview-pagination" aria-label="<%= t("admin.dbStats.preview.pagination") %>">
      <% if (tablePreview.hasPrevious) { %>
        <a class="button" href="/admin/db-stats?table=<%= encodeURIComponent(tablePreview.tableName) %>&limit=<%= tablePreview.limit %>&page=<%= tablePreview.page - 1 %>#table-data"><%= t("admin.dbStats.preview.previous") %></a>
      <% } %>
      <% if (tablePreview.hasNext) { %>
        <a class="button" href="/admin/db-stats?table=<%= encodeURIComponent(tablePreview.tableName) %>&limit=<%= tablePreview.limit %>&page=<%= tablePreview.page + 1 %>#table-data"><%= t("admin.dbStats.preview.next") %></a>
      <% } %>
    </nav>
  <% } %>
</section>
<%- include("../partials/footer") %>
