<!doctype html>
<html lang="<%= locale || "fr" %>" data-display-size="medium">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %> | <%= t("app.name") %></title>
    <script>
      (function () {
        try {
          var size = localStorage.getItem("g2m_display_size");
          if (["small", "medium", "large"].indexOf(size) === -1) {
            size = "medium";
          }
          document.documentElement.setAttribute("data-display-size", size);
        } catch (error) {
          document.documentElement.setAttribute("data-display-size", "medium");
        }
      }());
    </script>
    <link rel="icon" href="<%= faviconPath %>" sizes="32x32">
    <link rel="icon" type="image/png" href="<%= faviconPngPath %>" sizes="32x32">
    <link rel="stylesheet" href="/css/app.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <% if ((typeof mapAssets !== "undefined" && mapAssets) || (typeof tabulatorAssets !== "undefined" && tabulatorAssets)) { %>
      <link rel="stylesheet" href="https://unpkg.com/tabulator-tables@6.3.1/dist/css/tabulator.min.css">
    <% } %>
    <% if (typeof mapAssets !== "undefined" && mapAssets) { %>
      <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
      <link rel="stylesheet" href="https://unpkg.com/leaflet-extra-markers@1.2.2/dist/css/leaflet.extra-markers.min.css">
      <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css">
      <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css">
    <% } %>
    <% (typeof extraStyles !== "undefined" ? extraStyles : []).forEach((href) => { %>
      <link rel="stylesheet" href="<%= href %>">
    <% }) %>
    </head>
  <body>
    <%
      const permissionSet = typeof permissions !== "undefined" && permissions ? permissions : new Set();
      const can = (permission) => permissionSet.has(permission);
      const showInfographicsNav = can("infographics.read");
      const showSiteSearch = currentUser && can("infographics.read");
      const showSitesPlanningNav = false;
      const showVisualizationNav = can("sig.read") || showInfographicsNav || showSitesPlanningNav;
      const showSettingsNav = can("missions.read")
        || can("teams.read")
        || can("agents.read")
        || can("kobo.manage")
        || can("admin.access");
      const currentUserName = currentUser
        ? [currentUser.prenoms, currentUser.nom].filter(Boolean).join(" ").trim()
        : "";
      const currentUserRoleLabel = currentUser?.role_label || currentUser?.role || "";
      const currentUserInitials = currentUser
        ? (
            [currentUser.prenoms, currentUser.nom]
              .filter(Boolean)
              .map((part) => String(part).trim().charAt(0).toUpperCase())
              .join("")
              || String(currentUser.email || "").slice(0, 2).toUpperCase()
              || "U"
          ).slice(0, 2)
        : "";
    %>
    <header class="site-header">
      <a class="brand" href="/" aria-label="<%= t("app.homeAria") %>">
        <img class="brand-logo" src="/assets/images/Logo%20Rakall.png" alt="Rakall">
        <span class="brand-text">
          <span class="brand-product"><%= t("app.name") %></span>
          <span class="brand-product-mobile"><%= t("app.shortName") %></span>
          <span class="brand-release"><%= t("app.release") %></span>
        </span>
      </a>
      <button
        class="site-nav-toggle"
        id="site-nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-nav"
        aria-label="<%= t("nav.toggle") %>"
        data-label-open="<%= t("nav.toggle") %>"
        data-label-close="<%= t("nav.toggleClose") %>"
      >
        <i class="fa-solid fa-bars" aria-hidden="true"></i>
      </button>
      <nav id="site-nav" aria-label="<%= t("nav.ariaLabel") %>">
        <% if (showSiteSearch) { %>
          <button
            class="nav-button nav-icon-button site-search-open"
            id="site-search-open"
            type="button"
            title="<%= t("siteSearch.open") %>"
            aria-label="<%= t("siteSearch.open") %>"
          >
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
          </button>
        <% } %>
        <a class="nav-button" href="/">
          <i class="fa-solid fa-chart-line" aria-hidden="true"></i>
          <span><%= t("nav.dashboard") %></span>
        </a>
        <% if (showVisualizationNav) { %>
          <div class="nav-menu nav-visualization">
            <button
              class="nav-button nav-menu-trigger"
              type="button"
              aria-haspopup="true"
              aria-expanded="false"
              title="<%= t("nav.visualization") %>"
            >
              <i class="fa-solid fa-eye" aria-hidden="true"></i>
              <span><%= t("nav.visualization") %></span>
              <i class="fa-solid fa-chevron-down nav-menu-chevron" aria-hidden="true"></i>
            </button>
            <div class="nav-menu-panel" role="menu">
              <% if (can("sig.read")) { %>
                <a href="/cartographie" role="menuitem">
                  <i class="fa-solid fa-map-location-dot" aria-hidden="true"></i>
                  <span><%= t("nav.cartography") %></span>
                </a>
              <% } %>
              <% if (showSitesPlanningNav) { %>
                <a href="/sites" role="menuitem">
                  <i class="fa-solid fa-list-check" aria-hidden="true"></i>
                  <span><%= t("nav.sitesPlanning") %></span>
                </a>
              <% } %>
              <% if (showInfographicsNav) { %>
                <span class="nav-menu-panel-title"><%= t("nav.infographics") %></span>
                <a href="/infographies/mission-globale" role="menuitem">
                  <i class="fa-solid fa-chart-pie" aria-hidden="true"></i>
                  <span><%= t("nav.infographicsGlobal") %></span>
                </a>
                <a href="/infographies/par-superviseur" role="menuitem">
                  <i class="fa-solid fa-user-tie" aria-hidden="true"></i>
                  <span><%= t("nav.infographicsSupervisor") %></span>
                </a>
                <a href="/infographies/par-region" role="menuitem">
                  <i class="fa-solid fa-location-crosshairs" aria-hidden="true"></i>
                  <span><%= t("nav.infographicsRegion") %></span>
                </a>
              <% } %>
            </div>
          </div>
        <% } %>
        <% if (showSettingsNav) { %>
          <div class="nav-menu">
            <button
              class="nav-button nav-menu-trigger"
              type="button"
              aria-haspopup="true"
              aria-expanded="false"
              title="<%= t("nav.settings") %>"
            >
              <i class="fa-solid fa-gear" aria-hidden="true"></i>
              <span><%= t("nav.settings") %></span>
              <i class="fa-solid fa-chevron-down nav-menu-chevron" aria-hidden="true"></i>
            </button>
            <div class="nav-menu-panel" role="menu">
              <% if (can("missions.read")) { %>
                <a href="/missions" role="menuitem">
                  <i class="fa-solid fa-briefcase" aria-hidden="true"></i>
                  <span><%= t("nav.missions") %></span>
                </a>
              <% } %>
              <% if (can("teams.read")) { %>
                <a href="/equipes" role="menuitem">
                  <i class="fa-solid fa-people-group" aria-hidden="true"></i>
                  <span><%= t("nav.teams") %></span>
                </a>
              <% } %>
              <% if (can("agents.read")) { %>
                <a href="/agents" role="menuitem">
                  <i class="fa-solid fa-user-check" aria-hidden="true"></i>
                  <span><%= t("nav.agents") %></span>
                </a>
              <% } %>
              <% if (can("kobo.manage") || can("admin.access")) { %>
                <hr class="nav-menu-separator" aria-hidden="true">
              <% } %>
              <% if (can("kobo.manage")) { %>
                <a href="/parametrages/kobo" role="menuitem">
                  <i class="fa-solid fa-cloud-arrow-down" aria-hidden="true"></i>
                  <span><%= t("nav.kobo") %></span>
                </a>
              <% } %>
              <% if (can("admin.access")) { %>
                <% if (can("kobo.manage")) { %>
                  <hr class="nav-menu-separator" aria-hidden="true">
                <% } %>
                <a href="/admin" role="menuitem">
                  <i class="fa-solid fa-screwdriver-wrench" aria-hidden="true"></i>
                  <span><%= t("nav.admin") %></span>
                </a>
              <% } %>
            </div>
          </div>
        <% } %>
        <% if (false && typeof koboQuickSync !== "undefined" && koboQuickSync.visible) { %>
          <a
            class="nav-button nav-icon-button nav-kobo-sync <%= koboQuickSync.enabled ? "" : "is-disabled" %>"
            href="<%= koboQuickSync.enabled ? koboQuickSync.href : "#" %>"
            title="<%= t("kobo.light.open") %>"
            aria-label="<%= t("kobo.light.open") %>"
            aria-disabled="<%= koboQuickSync.enabled ? "false" : "true" %>"
            <%= koboQuickSync.enabled ? "data-kobo-light-open" : "tabindex=\"-1\"" %>
          >
            <i class="fa-solid fa-rotate" aria-hidden="true"></i>
          </a>
        <% } %>
        <% if (currentUser) { %>
          <div class="nav-menu nav-session">
            <button
              class="nav-button nav-menu-trigger nav-session-trigger"
              type="button"
              aria-haspopup="true"
              aria-expanded="false"
              title="<%= t("session.currentUser") %>"
            >
              <i class="fa-solid fa-circle-user" aria-hidden="true"></i>
              <span class="nav-session-initials"><%= currentUserInitials %></span>
            </button>
            <div class="nav-menu-panel nav-session-panel" role="menu">
              <div class="nav-session-identity" aria-label="<%= t("session.currentUser") %>">
                <strong><%= currentUserName || currentUser.email %></strong>
                <span><%= currentUser.email %></span>
                <span><%= t("session.role") %> : <%= currentUserRoleLabel %></span>
              </div>
              <button class="nav-menu-action" type="button" role="menuitem" data-personalization-open>
                <i class="fa-solid fa-sliders" aria-hidden="true"></i>
                <span><%= t("nav.personalization") %></span>
              </button>
              <form action="/logout" method="post" class="nav-session-form">
                <button type="submit" class="nav-session-logout" role="menuitem">
                  <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i>
                  <span><%= t("auth.logout") %></span>
                </button>
              </form>
            </div>
          </div>
        <% } else { %>
          <a class="nav-button nav-login-link" href="/login">
            <i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i>
            <span><%= t("auth.login.title") %></span>
          </a>
        <% } %>
      </nav>
      <% if (currentUser) { %>
        <div
          class="personalization-modal"
          id="personalization-modal"
          role="dialog"
          aria-modal="true"
          aria-labelledby="personalization-title"
          aria-hidden="true"
        >
          <div class="personalization-backdrop" data-personalization-close></div>
          <section class="personalization-dialog">
            <div class="personalization-header">
              <h2 id="personalization-title"><%= t("nav.personalization") %></h2>
              <button class="personalization-close" type="button" aria-label="<%= t("nav.personalizationClose") %>" data-personalization-close>
                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
              </button>
            </div>
            <div class="personalization-body">
              <section class="personalization-section" aria-labelledby="personalization-language-title">
                <h3 id="personalization-language-title"><%= t("nav.language") %></h3>
                <div class="personalization-language-options">
                  <a class="<%= locale === "fr" ? "is-active" : "" %>" href="<%= localeUrls.fr %>" lang="fr"><%= t("nav.languageFrench") %></a>
                  <a class="<%= locale === "en" ? "is-active" : "" %>" href="<%= localeUrls.en %>" lang="en"><%= t("nav.languageEnglish") %></a>
                  <a class="<%= locale === "es" ? "is-active " : "" %>is-hidden" href="<%= localeUrls.es %>" lang="es"><%= t("nav.languageSpanish") %></a>
                </div>
              </section>
              <section class="personalization-section" aria-labelledby="personalization-display-title">
                <h3 id="personalization-display-title"><%= t("nav.displaySize") %></h3>
                <div class="personalization-display-options" aria-label="<%= t("nav.displaySize") %>">
                  <button class="display-size-option" type="button" data-display-size-value="small"><%= t("nav.displaySizeSmall") %></button>
                  <button class="display-size-option" type="button" data-display-size-value="medium"><%= t("nav.displaySizeMedium") %></button>
                  <button class="display-size-option" type="button" data-display-size-value="large"><%= t("nav.displaySizeLarge") %></button>
                </div>
              </section>
            </div>
          </section>
        </div>
      <% } %>
      <% if (showSiteSearch) { %>
        <div
          class="site-search-modal"
          id="site-search-modal"
          role="dialog"
          aria-modal="true"
          aria-labelledby="site-search-title"
          aria-hidden="true"
          data-result-limit="<%= siteSearchConfig?.limit || 10 %>"
          data-message-min-length="<%= t("siteSearch.message.minLength") %>"
          data-message-loading="<%= t("siteSearch.message.loading") %>"
          data-message-empty="<%= t("siteSearch.message.empty") %>"
          data-message-error="<%= t("siteSearch.message.error") %>"
          data-message-coordinate-title="<%= t("siteSearch.coordinate.title") %>"
          data-message-coordinate-body="<%= t("siteSearch.coordinate.body") %>"
          data-message-coordinate-confirm="<%= t("siteSearch.coordinate.confirm") %>"
          data-message-coordinate-permuted="<%= t("siteSearch.coordinate.permuted") %>"
        >
          <div class="site-search-backdrop" data-site-search-close></div>
          <section class="site-search-dialog">
            <div class="site-search-header">
              <h2 id="site-search-title"><%= t("siteSearch.title") %></h2>
              <button class="site-search-close" type="button" aria-label="<%= t("siteSearch.close") %>" data-site-search-close>
                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
              </button>
            </div>
            <label class="site-search-field">
              <span><%= t("siteSearch.label") %></span>
              <input
                id="site-search-input"
                type="text"
                placeholder="<%= t("siteSearch.placeholder") %>"
                autocomplete="off"
                aria-controls="site-search-results"
                aria-describedby="site-search-hint"
              >
            </label>
            <p class="form-hint" id="site-search-hint"><%= t("siteSearch.hint") %></p>
            <div class="site-search-coordinate-suggestion" id="site-search-coordinate-suggestion" hidden></div>
            <div class="site-search-results" id="site-search-results" role="listbox" aria-live="polite"></div>
          </section>
        </div>
      <% } %>
    </header>
    <main class="container <%= typeof wideLayout !== "undefined" && wideLayout ? "container-wide" : "" %>">
