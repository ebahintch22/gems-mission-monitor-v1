<%- include("../partials/header", { title, mapAssets: true, wideLayout: true }) %>
<section class="sig-workspace" id="sig-workspace">
  <button
    class="sig-tools-toggle"
    id="sig-tools-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="sig-tools"
    aria-label="<%= t("sig.tools.show") %>"
  >
    <i class="fa-solid fa-sliders" aria-hidden="true"></i>
    <span><%= t("sig.tools.filters") %></span>
  </button>
  <aside class="sig-tools" id="sig-tools" aria-label="<%= t("sig.tools.aria") %>">
    <button
      class="sig-tools-close"
      id="sig-tools-close"
      type="button"
      aria-label="<%= t("sig.tools.hide") %>"
    >
      <i class="fa-solid fa-xmark" aria-hidden="true"></i>
    </button>
    <div class="sig-pal-root-content" id="sig-pal-root-content">
      <label class="sig-table-search sig-layer-header-search" id="sig-visited-sites-search-control" for="sig-visited-sites-search">
        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
        <input id="sig-visited-sites-search" type="search" placeholder="Rechercher un site" autocomplete="off">
        <button class="sig-table-search-clear" id="sig-visited-sites-search-clear" type="button" aria-label="Effacer la recherche" hidden>
          <i class="fa-solid fa-xmark" aria-hidden="true"></i>
        </button>
      </label>

      <div class="panel sig-panel sig-filter-panel" id="sig-filter-panel" hidden>
        <h2><%= t("sig.tools.filters") %></h2>
        <form class="sig-filters" id="sig-filters">
          <label class="sig-filter-wide">
            <%= t("sig.filters.mission") %>
            <select id="sig-mission-filter">
              <option value=""><%= t("sig.filters.allMissions") %></option>
              <% filters.missions.forEach((mission) => { %>
                <option value="<%= mission.id %>"><%= mission.name %></option>
              <% }) %>
            </select>
          </label>
          <label>
            <%= t("common.region") %>
            <select id="sig-region-filter">
              <option value=""><%= t("sig.filters.allRegions") %></option>
              <% Object.entries(administrativeChoiceIndex?.adm1_ci || {}).forEach(([code, label]) => { %>
                <option value="<%= code %>"><%= label %></option>
              <% }) %>
            </select>
          </label>
          <label>
            <%= t("sig.site.fields.department") %>
            <select id="sig-department-filter" disabled>
              <option value="">Tous les départements</option>
            </select>
          </label>
          <label>
            <%= t("sig.site.fields.subpref") %>
            <select id="sig-subprefecture-filter" disabled>
              <option value="">Toutes les sous-préfectures</option>
            </select>
          </label>
          <label>
            <%= t("sig.site.fields.ministry") %>
            <select id="sig-ministry-filter">
              <option value=""><%= t("sig.filters.allMinistries") %></option>
              <% Object.entries(administrativeChoiceIndex?.ministere || {}).forEach(([code, label]) => { %>
                <option value="<%= code %>"><%= label %></option>
              <% }) %>
            </select>
          </label>
          <label>
            <%= t("sig.filters.from") %>
            <input id="sig-date-from" type="date">
          </label>
          <label>
            <%= t("sig.filters.to") %>
            <input id="sig-date-to" type="date">
          </label>
          <div class="sig-filter-actions">
            <button class="button" id="sig-apply-filters" type="submit"><%= t("sig.filters.apply") %></button>
            <button class="button secondary" id="sig-reset-filters" type="button"><%= t("sig.filters.reset") %></button>
          </div>
        </form>
      </div>

      <div class="panel sig-panel sig-summary-panel" id="sig-summary-panel" hidden>
        <div class="panel-header">
          <h2><%= t("sig.summary.title") %></h2>
          <span class="sig-count" id="sig-visible-total">0</span>
        </div>
        <div class="sig-metrics">
          <div><span><%= t("sig.summary.valid") %></span><strong id="sig-count-valid">0</strong></div>
          <div><span><%= t("sig.summary.check") %></span><strong id="sig-count-check">0</strong></div>
          <div><span><%= t("sig.summary.rejected") %></span><strong id="sig-count-rejected">0</strong></div>
        </div>
      </div>

      <div class="panel sig-panel sig-table-panel">
        <div class="panel-header">
          <h2 id="sig-table-title"><%= t("sig.table.title") %></h2>
          <div class="sig-table-header-controls">
            <div class="sig-table-actions" role="toolbar" aria-label="<%= t("sig.rootActions.aria") %>">
              <button class="icon-button" id="sig-summary-toggle" type="button" title="<%= t("sig.summary.toggle") %>" aria-label="<%= t("sig.summary.toggle") %>" aria-expanded="false" aria-controls="sig-summary-panel">
                <i class="fa-solid fa-chart-simple" aria-hidden="true"></i>
              </button>
              <button class="icon-button" id="sig-filter-toggle" type="button" title="<%= t("sig.filters.open") %>" aria-label="<%= t("sig.filters.open") %>" aria-expanded="false" aria-controls="sig-filter-panel">
                <i class="fa-solid fa-filter" aria-hidden="true"></i>
              </button>
              <button class="icon-button" id="sig-columns-open-inline" type="button" title="<%= t("sig.columns.title") %>" aria-label="<%= t("sig.columns.title") %>" aria-haspopup="dialog" aria-controls="sig-columns-modal">
                <i class="fa-solid fa-table-columns" aria-hidden="true"></i>
              </button>
            </div>
          </div>
        </div>
        <div id="sig-table"></div>
      </div>

      <div class="sig-columns-modal" id="sig-columns-modal" role="dialog" aria-modal="true" aria-labelledby="sig-columns-modal-title" hidden>
        <div class="sig-columns-backdrop" data-sig-columns-close></div>
        <section class="sig-columns-dialog" role="document">
          <header>
            <h2 id="sig-columns-modal-title"><%= t("sig.columns.title") %></h2>
            <button class="icon-button" type="button" data-sig-columns-close aria-label="<%= t("sig.columns.close") %>">
              <i class="fa-solid fa-xmark" aria-hidden="true"></i>
            </button>
          </header>
          <form id="sig-columns-form" class="sig-columns-form">
            <div id="sig-columns-list" class="sig-columns-list"></div>
            <footer>
              <button class="button secondary" id="sig-columns-reset" type="button"><%= t("sig.filters.reset") %></button>
              <button class="button" type="submit"><%= t("sig.filters.apply") %></button>
            </footer>
          </form>
        </section>
      </div>
    </div>
  </aside>

  <div
    class="sig-resizer"
    id="sig-resizer"
    role="separator"
    aria-label="<%= t("sig.resizer.aria") %>"
    aria-controls="sig-tools sig-map-pane"
    aria-orientation="vertical"
    tabindex="0"
  ></div>

  <section class="sig-map-pane" id="sig-map-pane" aria-label="<%= t("sig.mapPane.aria") %>">
    <div class="sig-map-toolbar" role="toolbar" aria-label="<%= t("sig.mapTools.aria") %>">
      <button
        class="sig-map-tool is-active"
        id="sig-cluster-toggle"
        type="button"
        aria-pressed="true"
        title="<%= t("sig.cluster.disable") %>"
      >C</button>
      <% if (permissions && permissions.has("buildings.manage")) { %>
      <button
        class="sig-map-tool"
        id="sig-buildings-open"
        type="button"
        title="Bâtiments préparés"
        aria-label="Bâtiments préparés"
        data-can-import-buildings="true"
      >
        <i class="fa-solid fa-building" aria-hidden="true"></i>
      </button>
      <% } %>
      <button
        class="sig-map-tool"
        id="sig-measure-toggle"
        type="button"
        aria-pressed="false"
        title="Afficher les outils de mesure"
        aria-label="Afficher les outils de mesure"
      >
        <i class="fa-solid fa-ruler" aria-hidden="true"></i>
      </button>
      <input
        id="sig-geometry-import-input"
        class="is-hidden"
        type="file"
        accept=".gems,.gpx,application/gpx+xml,text/xml,text/plain"
      >
    </div>
    <div class="sig-geometry-overlay" id="sig-geometry-overlay" aria-label="Géométries importées">
      <div class="sig-geometry-overlay-header" id="sig-geometry-overlay-handle">
        <strong>Formes</strong>
        <button id="sig-geometry-clear" type="button" aria-label="Supprimer les formes importées">
          <i class="fa-solid fa-trash" aria-hidden="true"></i>
        </button>
      </div>
      <div id="sig-geometry-results-body" class="sig-geometry-results-body"></div>
    </div>
    <div class="sig-map-footer-band" id="sig-map-footer-band">
      <div class="sig-map-legend is-collapsed" id="sig-map-legend">
        <button
          class="sig-map-legend-toggle"
          id="sig-map-legend-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="sig-map-legend-items"
          aria-label="<%= t("sig.legend.expand") %>"
        >
          <i class="fa-solid fa-list" aria-hidden="true"></i>
          <span><%= t("sig.legend.title") %></span>
          <i class="fa-solid fa-chevron-up sig-map-legend-chevron" aria-hidden="true"></i>
        </button>
        <div class="sig-map-legend-items" id="sig-map-legend-items">
        </div>
      </div>
      <div class="sig-coordinate-control" id="sig-coordinate-control">Longitude - Latitude : --</div>
    </div>
    <div id="sig-map" aria-label="<%= t("sig.map.aria") %>"></div>
    <div class="g2m-loading-overlay is-active" id="sig-loading-overlay" role="status" aria-live="polite">
      <div class="g2m-loading-spinner" aria-hidden="true"></div>
      <span><%= t("common.loading") || "Chargement..." %></span>
    </div>
  </section>
</section>

<script id="sig-points-data" type="application/json"><%- JSON.stringify(points).replace(/</g, "\\u003c") %></script>
<script id="sig-regions-data" type="application/json"><%- JSON.stringify(regions).replace(/</g, "\\u003c") %></script>
<script id="sig-site-category-icons-data" type="application/json"><%- JSON.stringify(siteCategoryIcons).replace(/</g, "\\u003c") %></script>
<script id="sig-administrative-choices-data" type="application/json"><%- JSON.stringify(administrativeChoiceIndex || {}).replace(/</g, "\\u003c") %></script>
<script id="sig-geometry-import-config-data" type="application/json"><%- JSON.stringify(geometryImportConfig || {}).replace(/</g, "\\u003c") %></script>
