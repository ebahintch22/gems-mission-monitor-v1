<section class="submission-hero">
  <div class="submission-hero-main">
    <p class="submission-eyebrow">Dossier technique PADCI</p>
    <h1><%= view.header.title %></h1>
    <p><%= view.header.subtitle || submission.display_submission_id || submission.source_submission_id %></p>
    <div class="submission-badge-row">
      <% view.header.badges.forEach((badge) => { %>
        <span class="submission-badge"><strong><%= badge.label %></strong> <%- badge.html %></span>
      <% }) %>
    </div>
  </div>
  <div class="submission-actions" aria-label="Actions de la fiche">
    <a class="button" href="/cartographie"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i><span>Retour a la liste</span></a>
    <a class="button" href="/cartographie?site=<%= encodeURIComponent(submission.id) %>"><i class="fa-solid fa-map-location-dot" aria-hidden="true"></i><span>Voir sur la carte</span></a>
    <button class="button" type="button" data-print-submission><i class="fa-solid fa-print" aria-hidden="true"></i><span>Imprimer</span></button>
    <button class="button" type="button" disabled><i class="fa-solid fa-file-export" aria-hidden="true"></i><span>Exporter</span></button>
    <label class="submission-theme-select">
      <span>Theme</span>
      <select data-theme-switcher>
        <option value="blue">Institutionnel bleu</option>
        <option value="green">GEMS vert</option>
        <option value="sand">Sable et orange</option>
      </select>
    </label>
  </div>
</section>
