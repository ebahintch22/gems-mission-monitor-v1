<%- include("../partials/header", { title }) %>
<section class="page-heading">
  <div>
    <p class="eyebrow"><%= t("dashboard.eyebrow") %></p>
    <h1><%= t("dashboard.title") %></h1>
    <p class="muted"><%= t("dashboard.description") %></p>
  </div>
  <a class="button button-primary" href="/missions/new"><%= t("dashboard.actions.createMission") %></a>
</section>

<section class="stats" aria-label="<%= t("dashboard.stats.ariaLabel") %>">
  <article class="stat"><span><%= t("dashboard.stats.totalMissions") %></span><strong><%= stats.total %></strong></article>
  <article class="stat"><span><%= t("dashboard.stats.ongoing") %></span><strong><%= stats.ongoing %></strong></article>
  <article class="stat"><span><%= t("dashboard.stats.completed") %></span><strong><%= stats.completed %></strong></article>
  <article class="stat"><span><%= t("dashboard.stats.collectors") %></span><strong><%= stats.collectors %></strong></article>
</section>

<section class="panel">
  <div class="panel-header">
    <h2><%= t("dashboard.recent.title") %></h2>
    <a href="/missions"><%= t("dashboard.recent.viewAll") %></a>
  </div>
  <% if (!recentMissions.length) { %>
    <p class="empty"><%= t("dashboard.recent.empty") %></p>
  <% } else { %>
    <table class="simple-table">
      <thead>
        <tr>
          <th><%= t("common.mission") %></th>
          <th><%= t("common.region") %></th>
          <th><%= t("common.status") %></th>
          <th><%= t("common.start") %></th>
        </tr>
      </thead>
      <tbody>
        <% recentMissions.forEach((mission) => { %>
          <tr>
            <td><a href="/missions/<%= mission.id %>"><%= mission.name %></a></td>
            <td><%= mission.region %></td>
            <td><span class="status status-<%= mission.status %>"><%= t(`status.${mission.status}`) %></span></td>
            <td><%= mission.start_date || "-" %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</section>
<%- include("../partials/footer") %>
