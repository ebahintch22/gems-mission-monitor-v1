<%- include("../partials/header", { title }) %>
<section class="page-heading">
  <div>
    <p class="eyebrow"><%= t("users.eyebrow") %></p>
    <h1><%= formHeading %></h1>
    <p class="muted"><%= t("users.form.description") %></p>
  </div>
</section>

<section class="panel form-panel">
  <% if (error) { %><p class="alert" role="alert"><%= error %></p><% } %>
  <form action="<%= formAction %>" method="post" class="user-form">
    <label><%= t("users.fields.lastName") %>
      <input name="nom" required value="<%= values.nom || "" %>">
    </label>
    <label><%= t("users.fields.firstNames") %>
      <input name="prenoms" required value="<%= values.prenoms || "" %>">
    </label>
    <label><%= t("users.fields.email") %>
      <input type="email" name="email" required value="<%= values.email || "" %>">
    </label>
    <label><%= t("users.fields.phone") %>
      <input type="tel" name="telephone" value="<%= values.telephone || "" %>">
    </label>
    <label><%= t("users.fields.role") %>
      <select name="role" required>
        <% roles.forEach((role) => { %>
          <option value="<%= role.code_role %>" <%= values.role === role.code_role ? "selected" : "" %>><%= role.label %></option>
        <% }) %>
      </select>
      <% if (!roles.length) { %><small class="muted"><%= t("users.fields.noRoles") %></small><% } %>
    </label>
    <label><%= t("users.fields.status") %>
      <select name="statut" required>
        <% statuses.forEach((statut) => { %>
          <option value="<%= statut %>" <%= values.statut === statut ? "selected" : "" %>><%= t(`status.${statut}`) %></option>
        <% }) %>
      </select>
    </label>
    <fieldset class="regions-fieldset">
      <legend><%= t("users.fields.assignedRegions") %></legend>
      <% if (!regions.length) { %>
        <p class="empty"><%= t("users.fields.noRegions") %></p>
      <% } else { %>
        <div class="checkbox-grid">
          <% regions.forEach((region) => { %>
            <label class="checkbox-label">
              <input type="checkbox" name="region_ids" value="<%= region.id %>" <%= selectedRegionIds.includes(region.id) ? "checked" : "" %>>
              <span><%= region.nom_region %> <small>(<%= region.code_region %>)</small></span>
            </label>
          <% }) %>
        </div>
      <% } %>
    </fieldset>
    <p class="form-note"><%= t("users.form.authNote") %></p>
    <div class="form-actions">
      <a class="button" href="<%= cancelHref %>"><%= t("common.cancel") %></a>
      <button class="button button-primary" type="submit"><%= submitLabel %></button>
    </div>
  </form>
</section>
<%- include("../partials/footer") %>
