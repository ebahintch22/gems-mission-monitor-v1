<%- include("../partials/header", { title }) %>
<section class="page-heading">
  <div>
    <p class="eyebrow">Administration</p>
    <h1><%= formHeading %></h1>
    <p class="muted">Un superviseur pourra ensuite etre rattache a une equipe.</p>
  </div>
</section>

<section class="panel form-panel">
  <% if (error) { %><p class="alert" role="alert"><%= error %></p><% } %>
  <form action="<%= formAction %>" method="post" class="user-form">
    <label>Nom *
      <input name="nom" required value="<%= values.nom || "" %>">
    </label>
    <label>Prenoms *
      <input name="prenoms" required value="<%= values.prenoms || "" %>">
    </label>
    <label>Email *
      <input type="email" name="email" required value="<%= values.email || "" %>">
    </label>
    <label>Telephone
      <input type="tel" name="telephone" value="<%= values.telephone || "" %>">
    </label>
    <label>Role *
      <select name="role" required>
        <% roles.forEach((role) => { %>
          <option value="<%= role.code_role %>" <%= values.role === role.code_role ? "selected" : "" %>><%= role.label %></option>
        <% }) %>
      </select>
      <% if (!roles.length) { %><small class="muted">Importez d'abord le referentiel des roles.</small><% } %>
    </label>
    <label>Statut *
      <select name="statut" required>
        <% statuses.forEach((statut) => { %>
          <option value="<%= statut %>" <%= values.statut === statut ? "selected" : "" %>><%= statut %></option>
        <% }) %>
      </select>
    </label>
    <fieldset class="regions-fieldset">
      <legend>Regions d'affectation</legend>
      <% if (!regions.length) { %>
        <p class="empty">Importez le referentiel territorial avant d'affecter des regions.</p>
      <% } else { %>
        <div class="checkbox-grid">
          <% regions.forEach((region) => { %>
            <label class="checkbox-label">
              <input type="checkbox" name="region_ids" value="<%= region.id %>" <%= selectedRegionIds.includes(region.id) ? "checked" : "" %>>
              <span><%= region.nom_region %> <small>(<%= region.code_region %>)</small></span>
            </label>
          <% }) %>
        </div>
      <% } %>
    </fieldset>
    <p class="form-note">L'acces par mot de passe sera active avec le futur module d'authentification.</p>
    <div class="form-actions">
      <a class="button" href="<%= cancelHref %>">Annuler</a>
      <button class="button button-primary" type="submit"><%= submitLabel %></button>
    </div>
  </form>
</section>
<%- include("../partials/footer") %>
