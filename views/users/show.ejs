<%- include("../partials/header", { title }) %>
<section class="page-heading">
  <div>
    <p class="eyebrow"><%= t("users.show.eyebrow", { id: user.id }) %></p>
    <h1><%= user.prenoms %> <%= user.nom %></h1>
    <span class="status status-<%= user.statut %>"><%= t(`status.${user.statut}`) %></span>
  </div>
  <div class="heading-actions">
    <a class="button" href="/users"><%= t("users.actions.back") %></a>
    <a class="button button-primary" href="/users/<%= user.id %>/edit"><%= t("common.edit") %></a>
  </div>
</section>

<section class="detail-grid">
  <article class="panel details">
    <h2><%= t("users.show.profile") %></h2>
    <dl>
      <dt><%= t("common.email") %></dt><dd><%= user.email %></dd>
      <dt><%= t("common.phone") %></dt><dd><%= user.telephone || "-" %></dd>
      <dt><%= t("users.fields.role").replace(" *", "") %></dt><dd><%= user.role_label || user.role %></dd>
      <dt><%= t("users.show.assignments") %></dt><dd><%= user.role_description || "-" %></dd>
      <dt><%= t("users.show.lastLogin") %></dt><dd><%= user.last_login || t("users.show.neverConnected") %></dd>
    </dl>
  </article>
  <article class="panel">
    <h2><%= t("users.fields.assignedRegions") %></h2>
    <% if (!user.regions.length) { %>
      <p class="empty"><%= t("users.show.noRegion") %></p>
    <% } else { %>
      <ul class="territory-list">
        <% user.regions.forEach((region) => { %>
          <li><%= region.nom_region %> <span class="muted">(<%= region.code_region %>)</span></li>
        <% }) %>
      </ul>
    <% } %>
  </article>
</section>
<%- include("../partials/footer") %>
