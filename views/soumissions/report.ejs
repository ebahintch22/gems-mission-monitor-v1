<% const isPalEmbed = typeof embedMode !== "undefined" && embedMode === "pal"; %>
<% if (isPalEmbed) { %>
<!doctype html>
<html lang="<%= locale || "fr" %>" data-display-size="medium">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/app.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <% if (report.map) { %>
      <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
    <% } %>
  </head>
  <body class="report-embed report-embed-pal">
    <main class="report-embed-container">
<% } else { %>
<%- include("../partials/header", { title, mapAssets: Boolean(report.map) }) %>
<section class="page-heading report-page-heading">
  <div>
    <p class="eyebrow"><%= report.header.eyebrow %></p>
    <h1><%= report.header.title %></h1>
    <p class="muted"><%= report.template.label %> - <%= report.header.subtitle || submission.display_submission_id || submission.source_submission_id %></p>
  </div>
  <div class="heading-actions">
    <div class="report-command-menu">
      <button class="button" type="button" data-report-diagnostic-toggle>
        <i class="fa-solid fa-stethoscope" aria-hidden="true"></i>
        <span>Diagnostic</span>
      </button>
      <div class="report-command-panel" role="menu">
        <a href="/soumissions/<%= submission.id %>/diagnostics/geometric" role="menuitem" data-diagnostic-axis="geometric">
          <i class="fa-solid fa-draw-polygon" aria-hidden="true"></i>
          <span>Conformité géométrique / spatiale</span>
        </a>
        <button type="button" role="menuitem" disabled>
          <i class="fa-solid fa-diagram-project" aria-hidden="true"></i>
          <span>Cohérence logique</span>
        </button>
      </div>
    </div>
    <a class="button" href="/cartographie">Retour cartographie</a>
  </div>
</section>
<% } %>

<% if (isPalEmbed) { %>
  <section class="report-embed-toolbar">
    <div>
      <p class="eyebrow"><%= report.header.eyebrow %></p>
      <h1><%= report.header.title %></h1>
    </div>
    <div class="heading-actions">
      <div class="report-command-menu">
        <button class="button" type="button" data-report-diagnostic-toggle>
          <i class="fa-solid fa-stethoscope" aria-hidden="true"></i>
          <span>Diagnostic</span>
        </button>
        <div class="report-command-panel" role="menu">
          <a href="/soumissions/<%= submission.id %>/diagnostics/geometric?embed=pal" role="menuitem" data-diagnostic-axis="geometric">
            <i class="fa-solid fa-draw-polygon" aria-hidden="true"></i>
            <span>Conformité géométrique / spatiale</span>
          </a>
          <button type="button" role="menuitem" disabled>
            <i class="fa-solid fa-diagram-project" aria-hidden="true"></i>
            <span>Cohérence logique</span>
          </button>
        </div>
      </div>
    </div>
  </section>
<% } %>

<section class="submission-summary-grid" aria-label="Synthese de la soumission">
  <div class="stat">
    <span>Statut</span>
    <strong class="submission-status status-<%= submission.statut_validation %>">
      <%= report.header.status.value %>
    </strong>
  </div>
  <div class="stat">
    <span>Soumis le</span>
    <strong><%= new Date(submission.submitted_at).toLocaleDateString(locale) %></strong>
  </div>
  <div class="stat">
    <span>Template</span>
    <strong><%= report.template.version %></strong>
  </div>
  <div class="stat">
    <span>Diagnostic</span>
    <strong><%= report.diagnostics.length %></strong>
  </div>
</section>

<section class="submission-detail-layout">
  <div class="submission-detail-main">
    <section class="panel">
      <div class="panel-header">
        <h2>Synthese decisionnelle</h2>
        <span class="status"><%= report.template.id %></span>
      </div>
      <dl class="submission-kpi-list">
        <% report.summary.forEach((field) => { %>
          <dt><%= field.label %></dt>
          <dd><%= field.value %></dd>
        <% }) %>
      </dl>
    </section>

    <% report.sections.forEach((section) => { %>
      <section class="panel submission-section">
        <h2><%= section.label %></h2>
        <dl class="submission-field-list">
          <% section.fields.forEach((field) => { %>
            <dt><%= field.label %></dt>
            <dd><%= field.value %></dd>
          <% }) %>
        </dl>
      </section>
    <% }) %>
  </div>

  <aside class="submission-detail-side">
    <% if (report.map) { %>
      <section class="panel">
        <h2>Localisation</h2>
        <div id="submission-detail-map" class="submission-detail-map"></div>
      </section>
    <% } %>

    <section class="panel">
      <h2>Diagnostic rendu</h2>
      <% if (!report.diagnostics.length) { %>
        <p class="empty">Aucun champ manquant détecté.</p>
      <% } else { %>
        <dl class="submission-field-list submission-field-list-compact">
          <% report.diagnostics.slice(0, 12).forEach((entry) => { %>
            <dt><%= entry.type %></dt>
            <dd><%= entry.path %><%= entry.fallbackPath ? ` -> ${entry.fallbackPath}` : "" %></dd>
          <% }) %>
        </dl>
      <% } %>
    </section>
  </aside>
</section>

<% if (report.map) { %>
  <script id="submission-map-data" type="application/json"><%- JSON.stringify({
    latitude: report.map.latitude,
    longitude: report.map.longitude,
    title: report.header.title,
    precision: report.map.precision
  }).replace(/</g, "\\u003c") %></script>
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script>
    (function () {
      var payload = JSON.parse(document.getElementById("submission-map-data").textContent);
      var map = L.map("submission-detail-map", { maxZoom: 20 }).setView([payload.latitude, payload.longitude], 15);
      L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
        maxZoom: 20,
        attribution: "&copy; OpenStreetMap contributors"
      }).addTo(map);
      L.circleMarker([payload.latitude, payload.longitude], {
        color: "#006b5b",
        fillColor: "#006b5b",
        fillOpacity: 0.85,
        radius: 7,
        weight: 1
      }).bindPopup(payload.title).addTo(map);
      if (payload.precision) {
        L.circle([payload.latitude, payload.longitude], {
          color: "#006b5b",
          fillColor: "#d9f0eb",
          fillOpacity: 0.18,
          radius: Number(payload.precision)
        }).addTo(map);
      }
    }());
  </script>
<% } %>
<script>
  (function () {
    var menu = document.querySelector(".report-command-menu");
    if (!menu) return;
    var toggle = menu.querySelector("[data-report-diagnostic-toggle]");
    var links = menu.querySelectorAll("[data-diagnostic-axis]");
    if (toggle) {
      toggle.addEventListener("click", function () {
        menu.classList.toggle("is-open");
      });
    }
    document.addEventListener("click", function (event) {
      if (!menu.contains(event.target)) {
        menu.classList.remove("is-open");
      }
    });
    links.forEach(function (link) {
      link.addEventListener("click", function (event) {
        if (document.body.classList.contains("report-embed-pal") && window.parent && window.parent !== window) {
          event.preventDefault();
          window.parent.postMessage({
            type: "g2m:open-submission-diagnostic",
            submissionId: "<%= submission.id %>",
            axis: link.dataset.diagnosticAxis,
            title: link.textContent.trim()
          }, window.location.origin);
        }
      });
    });
  }());
</script>
<% if (isPalEmbed) { %>
    </main>
  </body>
</html>
<% } else { %>
<%- include("../partials/footer") %>
<% } %>
