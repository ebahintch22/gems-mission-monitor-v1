<%- include("../partials/header", { title }) %>
<section class="page-heading">
  <div>
    <p class="eyebrow"><%= t("teams.eyebrow") %></p>
    <h1><%= formHeading %></h1>
    <p class="muted"><%= t("teams.form.description") %></p>
  </div>
</section>

<section class="panel form-panel">
  <% if (error) { %><p class="alert" role="alert"><%= error %></p><% } %>
  <form action="<%= formAction %>" method="post" class="equipe-form">
    <label><%= t("teams.fields.name") %>
      <input name="nom_equipe" required value="<%= values.nom_equipe || "" %>">
    </label>
    <label><%= t("teams.fields.status") %>
      <select name="statut" required>
        <% statuses.forEach((statut) => { %>
          <option value="<%= statut %>" <%= (values.statut || "planifiee") === statut ? "selected" : "" %>><%= t(`status.${statut}`) %></option>
        <% }) %>
      </select>
    </label>
    <label><%= t("teams.fields.mission") %>
      <select name="mission_id" required>
        <option value=""><%= t("teams.fields.selectMission") %></option>
        <% missions.forEach((mission) => { %>
          <option value="<%= mission.id %>" <%= Number(values.mission_id) === mission.id ? "selected" : "" %>><%= mission.name %> (<%= t(`status.${mission.status}`) %>)</option>
        <% }) %>
      </select>
      <% if (!missions.length) { %><small class="muted"><%= t("teams.fields.noMission") %></small><% } %>
    </label>
    <label><%= t("teams.fields.supervisor") %>
      <select name="superviseur_id">
        <option value=""><%= t("agents.fields.assignLater") %></option>
        <% supervisors.forEach((supervisor) => { %>
          <option value="<%= supervisor.id %>" <%= Number(values.superviseur_id) === supervisor.id ? "selected" : "" %>><%= supervisor.prenoms %> <%= supervisor.nom %></option>
        <% }) %>
      </select>
      <% if (!supervisors.length) { %><small class="muted"><%= t("teams.fields.noSupervisor") %></small><% } %>
    </label>
    <fieldset class="regions-fieldset">
      <legend><%= t("teams.fields.assignedRegions") %></legend>
      <% if (!regions.length) { %>
        <p class="empty"><%= t("teams.fields.noRegions") %></p>
      <% } else { %>
        <div class="checkbox-grid">
          <% regions.forEach((region) => { %>
            <label class="checkbox-label">
              <input type="checkbox" name="region_ids" value="<%= region.id %>" <%= selectedRegionIds.includes(region.id) ? "checked" : "" %>>
              <span><%= region.nom_region %> <small>(<%= region.code_region %>)</small></span>
            </label>
          <% }) %>
        </div>
      <% } %>
    </fieldset>
    <div class="form-actions">
      <a class="button" href="<%= cancelHref %>"><%= t("common.cancel") %></a>
      <button class="button button-primary" type="submit"><%= submitLabel %></button>
    </div>
  </form>
</section>
<%- include("../partials/footer") %>
