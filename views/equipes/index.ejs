<%- include("../partials/header", { title }) %>
<section class="page-heading">
  <div>
    <p class="eyebrow">Collecte terrain</p>
    <h1>Equipes de collecte</h1>
    <p class="muted">Equipes rattachees aux missions, superviseurs et zones regionales.</p>
  </div>
  <a class="button button-primary" href="/equipes/new">Nouvelle equipe</a>
</section>

<section class="panel">
  <div class="panel-header">
    <h2>Registre des equipes</h2>
    <span class="muted"><%= equipes.length %> equipe(s)</span>
  </div>
  <% if (!equipes.length) { %>
    <p class="empty">Aucune equipe n'est encore enregistree.</p>
  <% } else { %>
    <table class="simple-table">
      <thead>
        <tr><th>Equipe</th><th>Mission</th><th>Superviseur</th><th>Regions</th><th>Statut</th><th></th></tr>
      </thead>
      <tbody>
        <% equipes.forEach((equipe) => { %>
          <tr>
            <td><a href="/equipes/<%= equipe.id %>"><%= equipe.nom_equipe %></a></td>
            <td><%= equipe.mission_name %></td>
            <td><%= equipe.superviseur_name || "Non affecte" %></td>
            <td><%= equipe.regions || "-" %></td>
            <td><span class="status status-<%= equipe.statut %>"><%= equipe.statut %></span></td>
            <td><a href="/equipes/<%= equipe.id %>/edit">Modifier</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</section>
<%- include("../partials/footer") %>
