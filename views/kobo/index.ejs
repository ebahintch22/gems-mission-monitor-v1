<%- include("../partials/header", { title }) %>
<section class="page-heading">
  <div>
    <p class="eyebrow"><%= t("kobo.admin.eyebrow") %></p>
    <h1><%= t("kobo.admin.title") %></h1>
    <p class="muted"><%= t("kobo.admin.description") %></p>
  </div>
</section>

<% if (notice) { %><p class="alert alert-success" role="status"><%= notice %></p><% } %>
<% if (error) { %><p class="alert" role="alert"><%= error %></p><% } %>

<section class="kobo-layout">
  <div class="panel">
    <div class="panel-header">
      <h2><%= t("kobo.config.title") %></h2>
      <span class="status <%= config.ready ? "status-actif" : "status-suspendu" %>">
        <%= config.ready ? t("common.ready") : t("common.incomplete") %>
      </span>
    </div>
    <dl class="kobo-status-list">
      <dt><%= t("kobo.config.baseUrl") %></dt>
      <dd><%= config.baseUrlConfigured ? t("common.configured") : t("common.missing") %></dd>
      <dt><%= t("kobo.config.apiToken") %></dt>
      <dd><%= config.tokenConfigured ? t("common.configuredMasc") : t("common.missingMasc") %></dd>
      <dt><%= t("kobo.config.defaultAsset") %></dt>
      <dd><%= config.defaultAssetUid || t("common.notProvided") %></dd>
      <dt><%= t("kobo.config.defaultMission") %></dt>
      <dd><%= config.defaultMissionId || t("common.notProvidedFem") %></dd>
    </dl>

    <form action="/parametrages/kobo/config" method="post" class="kobo-config-form">
      <label><%= t("kobo.config.baseUrl") %> *
        <input
          type="url"
          name="base_url"
          value="<%= config.baseUrl %>"
          placeholder="<%= t("common.placeholderExample", { example: "https://kf.kobotoolbox.org" }) %>"
          required
        >
      </label>
      <label><%= t("kobo.config.apiToken") %> *
        <input
          type="password"
          name="api_token"
          placeholder="<%= config.tokenConfigured ? t("kobo.config.tokenAlreadySet") : t("common.placeholderExample", { example: t("kobo.config.tokenPlaceholder") }) %>"
          autocomplete="off"
          <%= config.tokenConfigured ? "" : "required" %>
        >
        <% if (config.maskedToken) { %>
          <span class="form-hint"><%= t("kobo.config.activeToken", { token: config.maskedToken }) %></span>
        <% } %>
      </label>
      <p class="form-note">
        <%= t("kobo.config.note") %>
      </p>
      <div class="form-actions">
        <button class="button button-primary" type="submit">
          <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>
          <%= t("kobo.actions.saveConfig") %>
        </button>
      </div>
    </form>

    <div class="kobo-actions">
      <form action="/parametrages/kobo/test" method="post">
        <button class="button button-primary" type="submit">
          <i class="fa-solid fa-plug" aria-hidden="true"></i>
          <%= t("kobo.actions.testConnection") %>
        </button>
      </form>
      <form action="/parametrages/kobo/assets" method="post">
        <input type="hidden" name="limit" value="25">
        <button class="button" type="submit">
          <i class="fa-solid fa-list" aria-hidden="true"></i>
          <%= t("kobo.actions.loadForms") %>
        </button>
      </form>
    </div>
  </div>

  <div class="panel">
    <h2><%= t("kobo.sync.title") %></h2>
    <form action="/parametrages/kobo/sync" method="post" class="kobo-sync-form">
      <label><%= t("kobo.sync.mission") %>
        <select name="mission_id" required>
          <option value=""><%= t("kobo.sync.selectMission") %></option>
          <% missions.forEach((mission) => { %>
            <option value="<%= mission.id %>" <%= String(values.mission_id) === String(mission.id) ? "selected" : "" %>>
              <%= mission.name %><%= mission.kobo_asset_uid ? ` - ${mission.kobo_asset_uid}` : "" %>
            </option>
          <% }) %>
        </select>
      </label>
      <label><%= t("kobo.sync.assetUid") %>
        <input name="asset_uid" required value="<%= values.asset_uid %>" placeholder="<%= t("common.placeholderExample", { example: "aBcDeF123" }) %>">
      </label>
      <label><%= t("kobo.sync.gpsField") %>
        <input name="gps_field" value="<%= values.gps_field %>" placeholder="<%= t("common.placeholderExample", { example: "coordonnees_gps" }) %>">
      </label>
      <label><%= t("kobo.sync.agentCodeField") %>
        <input name="agent_code_field" value="<%= values.agent_code_field %>" placeholder="<%= t("common.placeholderExample", { example: "modA/enqueteur" }) %>">
      </label>
      <label><%= t("kobo.sync.formType") %>
        <input name="form_type" value="<%= values.form_type %>">
      </label>
      <label><%= t("kobo.sync.limit") %>
        <input type="number" name="limit" min="1" max="1000" value="<%= values.limit %>">
      </label>
      <label><%= t("kobo.sync.since") %>
        <input type="datetime-local" name="since" value="<%= values.since %>">
      </label>
      <label class="checkbox-label kobo-dry-run">
        <input type="checkbox" name="dry_run" <%= values.dry_run ? "checked" : "" %>>
        <%= t("kobo.sync.dryRun") %>
      </label>
      <div class="form-actions">
        <button class="button button-primary" type="submit">
          <i class="fa-solid fa-rotate" aria-hidden="true"></i>
          <%= t("kobo.actions.sync") %>
        </button>
      </div>
    </form>
  </div>
</section>

<% if (assets.length) { %>
  <section class="panel">
    <h2><%= t("kobo.assets.title") %></h2>
    <table class="simple-table">
      <thead>
        <tr>
          <th><%= t("kobo.assets.uid") %></th>
          <th><%= t("common.name") %></th>
          <th><%= t("common.status") %></th>
          <th><%= t("kobo.assets.lastModified") %></th>
        </tr>
      </thead>
      <tbody>
        <% assets.forEach((asset) => { %>
          <tr>
            <td><code><%= asset.uid %></code></td>
            <td><%= asset.name %></td>
            <td><%= asset.deploymentStatus %></td>
            <td><%= asset.dateModified || t("common.notProvidedFem") %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </section>
<% } %>

<% if (summary) { %>
  <section class="panel">
    <h2><%= t("kobo.summary.title") %></h2>
    <div class="kobo-summary">
      <div><span><%= t("common.mission") %></span><strong><%= summary.missionName %></strong></div>
      <div><span><%= t("kobo.summary.read") %></span><strong><%= summary.read %></strong></div>
      <div><span><%= t("kobo.summary.valid") %></span><strong><%= summary.valid %></strong></div>
      <div><span><%= t("kobo.summary.inserted") %></span><strong><%= summary.inserted %></strong></div>
      <div><span><%= t("kobo.summary.skipped") %></span><strong><%= summary.skipped %></strong></div>
      <div><span><%= t("common.errors") %></span><strong><%= summary.errors.length %></strong></div>
    </div>
    <% if (summary.errors.length) { %>
      <ul class="kobo-error-list">
        <% summary.errors.slice(0, 10).forEach((message) => { %>
          <li><%= message %></li>
        <% }) %>
      </ul>
    <% } %>
  </section>
<% } %>
<%- include("../partials/footer") %>
