<%- include("../partials/header", { title }) %>
<section class="page-heading">
  <div>
    <p class="eyebrow">Parametrages</p>
    <h1>Administration KoboToolbox</h1>
    <p class="muted">Connexion API v2, exploration des formulaires et synchronisation des soumissions terrain.</p>
  </div>
</section>

<% if (notice) { %><p class="alert alert-success" role="status"><%= notice %></p><% } %>
<% if (error) { %><p class="alert" role="alert"><%= error %></p><% } %>

<section class="kobo-layout">
  <div class="panel">
    <div class="panel-header">
      <h2>Etat de configuration</h2>
      <span class="status <%= config.ready ? "status-actif" : "status-suspendu" %>">
        <%= config.ready ? "pret" : "incomplet" %>
      </span>
    </div>
    <dl class="kobo-status-list">
      <dt>URL KoboToolbox</dt>
      <dd><%= config.baseUrlConfigured ? "configuree" : "absente" %></dd>
      <dt>Jeton API</dt>
      <dd><%= config.tokenConfigured ? "configure" : "absent" %></dd>
      <dt>Formulaire par defaut</dt>
      <dd><%= config.defaultAssetUid || "Non renseigne" %></dd>
      <dt>Mission par defaut</dt>
      <dd><%= config.defaultMissionId || "Non renseignee" %></dd>
    </dl>

    <form action="/parametrages/kobo/config" method="post" class="kobo-config-form">
      <label>URL KoboToolbox *
        <input
          type="url"
          name="base_url"
          value="<%= config.baseUrl %>"
          placeholder="https://kf.kobotoolbox.org"
          required
        >
      </label>
      <label>Jeton API *
        <input
          type="password"
          name="api_token"
          placeholder="<%= config.tokenConfigured ? "Jeton deja renseigne" : "Coller le jeton API" %>"
          autocomplete="off"
          <%= config.tokenConfigured ? "" : "required" %>
        >
        <% if (config.maskedToken) { %>
          <span class="form-hint">Jeton actif : <%= config.maskedToken %></span>
        <% } %>
      </label>
      <p class="form-note">
        Ces valeurs sont conservees en memoire pour l'execution courante. En production Render, declarez-les aussi comme variables d'environnement.
      </p>
      <div class="form-actions">
        <button class="button button-primary" type="submit">
          <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>
          Enregistrer les parametres
        </button>
      </div>
    </form>

    <div class="kobo-actions">
      <form action="/parametrages/kobo/test" method="post">
        <button class="button button-primary" type="submit">
          <i class="fa-solid fa-plug" aria-hidden="true"></i>
          Tester la connexion
        </button>
      </form>
      <form action="/parametrages/kobo/assets" method="post">
        <input type="hidden" name="limit" value="25">
        <button class="button" type="submit">
          <i class="fa-solid fa-list" aria-hidden="true"></i>
          Charger les formulaires
        </button>
      </form>
    </div>
  </div>

  <div class="panel">
    <h2>Synchroniser les soumissions</h2>
    <form action="/parametrages/kobo/sync" method="post" class="kobo-sync-form">
      <label>Mission G2M *
        <select name="mission_id" required>
          <option value="">Selectionner une mission</option>
          <% missions.forEach((mission) => { %>
            <option value="<%= mission.id %>" <%= String(values.mission_id) === String(mission.id) ? "selected" : "" %>>
              <%= mission.name %><%= mission.kobo_asset_uid ? ` - ${mission.kobo_asset_uid}` : "" %>
            </option>
          <% }) %>
        </select>
      </label>
      <label>UID formulaire Kobo *
        <input name="asset_uid" required value="<%= values.asset_uid %>" placeholder="aBcDeF123">
      </label>
      <label>Champ GPS Kobo
        <input name="gps_field" value="<%= values.gps_field %>" placeholder="coordonnees_gps">
      </label>
      <label>Champ code agent
        <input name="agent_code_field" value="<%= values.agent_code_field %>" placeholder="modA/enqueteur">
      </label>
      <label>Type de formulaire
        <input name="form_type" value="<%= values.form_type %>">
      </label>
      <label>Limite de lecture
        <input type="number" name="limit" min="1" max="1000" value="<%= values.limit %>">
      </label>
      <label>Date de reprise
        <input type="datetime-local" name="since" value="<%= values.since %>">
      </label>
      <label class="checkbox-label kobo-dry-run">
        <input type="checkbox" name="dry_run" <%= values.dry_run ? "checked" : "" %>>
        Simuler sans ecrire en base
      </label>
      <div class="form-actions">
        <button class="button button-primary" type="submit">
          <i class="fa-solid fa-rotate" aria-hidden="true"></i>
          Synchroniser
        </button>
      </div>
    </form>
  </div>
</section>

<% if (assets.length) { %>
  <section class="panel">
    <h2>Formulaires KoboToolbox</h2>
    <table class="simple-table">
      <thead>
        <tr>
          <th>UID</th>
          <th>Nom</th>
          <th>Statut</th>
          <th>Derniere modification</th>
        </tr>
      </thead>
      <tbody>
        <% assets.forEach((asset) => { %>
          <tr>
            <td><code><%= asset.uid %></code></td>
            <td><%= asset.name %></td>
            <td><%= asset.deploymentStatus %></td>
            <td><%= asset.dateModified || "Non renseignee" %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </section>
<% } %>

<% if (summary) { %>
  <section class="panel">
    <h2>Resultat de synchronisation</h2>
    <div class="kobo-summary">
      <div><span>Mission</span><strong><%= summary.missionName %></strong></div>
      <div><span>Soumissions lues</span><strong><%= summary.read %></strong></div>
      <div><span>Valides</span><strong><%= summary.valid %></strong></div>
      <div><span>Inserees</span><strong><%= summary.inserted %></strong></div>
      <div><span>Deja presentes</span><strong><%= summary.skipped %></strong></div>
      <div><span>Erreurs</span><strong><%= summary.errors.length %></strong></div>
    </div>
    <% if (summary.errors.length) { %>
      <ul class="kobo-error-list">
        <% summary.errors.slice(0, 10).forEach((message) => { %>
          <li><%= message %></li>
        <% }) %>
      </ul>
    <% } %>
  </section>
<% } %>
<%- include("../partials/footer") %>
