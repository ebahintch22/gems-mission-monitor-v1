+test("GET /media/:id/view genere une URL signee Wasabi pour un utilisateur autorise", async () => {
+  const previousEnv = {
+    WASABI_ACCESS_KEY_ID: process.env.WASABI_ACCESS_KEY_ID,
+    WASABI_SECRET_ACCESS_KEY: process.env.WASABI_SECRET_ACCESS_KEY,
+    WASABI_REGION: process.env.WASABI_REGION,
+    WASABI_BUCKET: process.env.WASABI_BUCKET,
+    WASABI_ENDPOINT: process.env.WASABI_ENDPOINT
+  };
+  process.env.WASABI_ACCESS_KEY_ID = "access-test";
+  process.env.WASABI_SECRET_ACCESS_KEY = "secret-test";
+  process.env.WASABI_REGION = "eu-central-1";
+  process.env.WASABI_BUCKET = "g2m-media-test";
+  process.env.WASABI_ENDPOINT = "https://s3.eu-central-1.wasabisys.com";
+
+  try {
+    const media = MediaFile.create({
+      id: "media-route-test",
+      bucket: "g2m-media-test",
+      object_key: "media/test/2026/07/media-route-test/original/photo.jpg",
+      original_filename: "photo.jpg",
+      stored_filename: "photo.jpg",
+      mime_type: "image/jpeg",
+      media_type: "image",
+      size_bytes: 42,
+      checksum_sha256: "abc123",
+      source: "manual_upload",
+      visibility: "private"
+    });
+    MediaFile.createLink({
+      media_file_id: media.id,
+      entity_type: "site",
+      entity_ref: "SITE-001",
+      role: "photo_site"
+    });
+
+    const gisCookie = await loginTestUser({
+      email: "gis.media-view@g2m.test",
+      role: "specialiste_gis"
+    });
+    const agentCookie = await loginTestUser({
+      email: "agent.media-view-denied@g2m.test",
+      role: "agent"
+    });
+
+    const anonymousResponse = await request(app).get(`/media/${media.id}/view`);
+    const deniedResponse = await request(app)
+      .get(`/media/${media.id}/view`)
+      .set("Cookie", agentCookie);
+    const response = await request(app)
+      .get(`/media/${media.id}/view`)
+      .set("Cookie", gisCookie);
+
+    assert.equal(anonymousResponse.status, 302);
+    assert.equal(anonymousResponse.headers.location, `/login?next=%2Fmedia%2F${media.id}%2Fview`);
+    assert.equal(deniedResponse.status, 403);
+    assert.equal(response.status, 302);
+    assert.match(response.headers.location, /^https:\/\/s3\.eu-central-1\.wasabisys\.com\/g2m-media-test\/media\/test\/2026\/07\/media-route-test\/original\/photo\.jpg\?/);
+    assert.match(response.headers.location, /X-Amz-Algorithm=AWS4-HMAC-SHA256/);
+    assert.match(response.headers.location, /response-content-disposition=inline/);
+  } finally {
+    Object.entries(previousEnv).forEach(([key, value]) => {
+      if (value === undefined) {
+        delete process.env[key];
+      } else {
+        process.env[key] = value;
+      }
+    });
+  }
+});
