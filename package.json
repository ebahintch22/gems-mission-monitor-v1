{
  "name": "gems-mission-monitor",
  "version": "1.0.0",
  "description": "Suivi GEMS des missions de collecte - socle MVP Express et SQLite",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "node --test",
    "report:docx": "node scripts/generate-report-docx.mjs KBase-docs/RAPPORT_TECHNIQUE.md KBase-docs/RAPPORT_TECHNIQUE.docx",
    "territories:import": "node scripts/import-territories.js",
    "roles:import": "node scripts/import-roles.js",
    "agents:import": "node scripts/import-agents.js",
    "sites-planning:import": "node scripts/import-sites-planning.js",
    "submissions:seed": "node scripts/seed-submissions.js",
    "g2m:create-batch": "node scripts/g2m-create-batch.mjs",
    "kobo:sync": "node scripts/sync-kobo.js"
  },
  "keywords": [
    "gems",
    "express",
    "sqlite",
    "kobotoolbox"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@turf/union": "^7.3.5",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.4.1",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^6.2.1",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.10",
    "vanilla-jsoneditor": "^3.12.0"
  },
  "devDependencies": {
    "docx": "^9.7.0",
    "marked": "^18.0.4",
    "nodemon": "^3.1.14",
    "supertest": "^7.1.4"
  },
  "engines": {
    "node": ">=20"
  },
  "nodemonConfig": {
    "watch": [
      "app.js",
      "config",
      "controllers",
      "models",
      "routes",
      "services",
      "views",
      "public/js",
      "public/css"
    ],
    "ext": "js,json,ejs,css",
    "ignore": [
      "node_modules",
      "data",
      "*.docx",
      "*.md",
      "*.log"
    ]
  }
}
